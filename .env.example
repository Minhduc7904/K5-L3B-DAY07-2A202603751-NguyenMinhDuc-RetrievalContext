# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# --- LLM for the agent (OpenAI) ---
OPENAI_API_KEY=
# Any OpenAI chat model that supports tool calling; change it if your account uses another one.
OPENAI_MODEL=gpt-4o-mini

# --- Day 6 vector store (local Docker, started from the Day 6 repo: starter/docker-compose.yml) ---
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# --- Query embedding: MUST be the same model that built the Day 6 index ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSIONS=768
# Strategy of the Day 6 chunks table used for Day 7 (B = structure-aware chunks, 662 rows)
CHUNK_STRATEGY=B
